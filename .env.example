# Copia este archivo como .env y llena los valores. El .env NO se sube a git
# (esta en .gitignore) y solo sirve para desarrollo local: en produccion las
# variables se configuran en el panel de Railway.
#
#   cp .env.example .env
#   python manage.py runserver

# --- Django ---------------------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# 1 para desarrollo (muestra errores completos), 0 en produccion.
DJANGO_DEBUG=1

# --- Acceso con Google ----------------------------------------------------
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de
# OAuth > Aplicacion web. URI de redireccion autorizado para local:
#   http://127.0.0.1:8000/oauth/complete/google-oauth2/
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=

# --- Opcionales -----------------------------------------------------------
# Carpeta donde viven las bases (django.db, inventory.db, stats.db). Sin esto
# se guardan junto al codigo.
# DATA_DIR=

# Solo si sirves desde un dominio propio; el de Railway se autoriza solo.
# DJANGO_ALLOWED_HOSTS=midominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com
